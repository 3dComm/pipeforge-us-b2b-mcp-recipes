          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-http-min",
              "leftValue": "={{ Number($json.http_status || 0) }}",
              "operator": {
                "type": "number",
                "operation": "gte"
              },
              "rightValue": 200
            },
            {
              "id": "cond-http-max",
              "leftValue": "={{ Number($json.http_status || 999) }}",
              "operator": {
                "type": "number",
                "operation": "lt"
              },
              "rightValue": 400
            }
          ]
        }
      }
    },
    {
      "id": "ent-node-12-enrich-ctx",
      "name": "Attach Upstream Context & Urgency",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1640,
        440
      ],
      "parameters": {
        "jsCode": "const lookup = $('Deduplicate & Batch New Domains').first().json._signalLookup || {};\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  const d = String(j.domain || '').toLowerCase();\n  const meta = lookup[d] || {};\n  const dm = String(j.dmarc_policy || '').toLowerCase();\n  const sev = Number(j.severity_score || 0);\n  const urgency = (sev >= 60 || dm === 'missing' || dm.includes('missing'))\n    ? 'CRITICAL'\n    : (sev >= 30 ? 'MEDIUM' : 'LOW');\n  out.push({\n    json: {\n      ...j,\n      urgency_tier: urgency,\n      upstream_source: meta.signal_source || 'B2B_SIGNAL',\n      company_name: meta.company_name || j.domain,\n      decision_maker: meta.decision_maker || 'Security / IT Lead',\n      signal_detail: meta.signal_detail || '',\n      signal_url: meta.signal_url || '',\n      cold_email_mx_provider: j.cold_email_mx_provider || j.mx_provider || 'Unknown'\n    }\n  });\n}\nreturn out;"
      }
    },
