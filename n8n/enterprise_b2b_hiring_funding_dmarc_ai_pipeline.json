    {
      "id": "ent-node-09-dedup-batch",
      "name": "Deduplicate & Batch New Domains",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        440
      ],
      "parameters": {
        "jsCode": "const processedSet = new Set();\nconst signals = [];\n\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  if (j.domain && !j.signal_source) {\n    processedSet.add(String(j.domain).trim().toLowerCase());\n  } else if (j.domain && j.signal_source) {\n    signals.push(j);\n  }\n}\n\nconst fresh = signals.filter(s => !processedSet.has(String(s.domain).toLowerCase()));\nconst lookup = {};\nconst domains = [];\nfor (const s of fresh) {\n  const d = String(s.domain).toLowerCase();\n  if (!lookup[d]) {\n    lookup[d] = s;\n    domains.push(d);\n  }\n}\n\nif (!domains.length) {\n  return [];\n}\n\nreturn [{\n  json: {\n    domains: domains.slice(0, 35),\n    maxConcurrency: 5,\n    timeoutSeconds: 6,\n    minSeverityScore: 0,\n    _signalLookup: lookup\n  }\n}];"
      }
    },
