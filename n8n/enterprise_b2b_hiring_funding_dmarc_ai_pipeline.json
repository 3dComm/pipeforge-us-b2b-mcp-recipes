    {
      "id": "ent-node-04-norm-ats",
      "name": "Normalize ATS Signals & Map Domains",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        260
      ],
      "parameters": {
        "jsCode": "const DOMAIN_MAP = {\n  scaleai: 'scale.com',\n  datadog: 'datadoghq.com',\n  linear: 'linear.app',\n  elevenlabs: 'elevenlabs.io',\n  perplexity: 'perplexity.ai',\n  harvey: 'harvey.ai',\n  notion: 'notion.so',\n  ro: 'ro.co',\n  outreach: 'outreach.io',\n  vercel: 'vercel.com',\n  supabase: 'supabase.com',\n  posthog: 'posthog.com',\n  anthropic: 'anthropic.com',\n  stripe: 'stripe.com',\n  vanta: 'vanta.com',\n  ramp: 'ramp.com',\n  brex: 'brex.com',\n  figma: 'figma.com'\n};\nconst seen = new Set();\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  const direct = String(j.company_domain || '').trim().toLowerCase();\n  const slug = String(j.company_slug || '').toLowerCase().replace(/[^a-z0-9]/g, '');\n  const domain = direct || (slug ? (DOMAIN_MAP[slug] || `${slug}.com`) : '');\n  if (!domain || seen.has(domain)) continue;\n  seen.add(domain);\n  out.push({\n    json: {\n      domain,\n      signal_source: 'ATS_HIRING_INTENT',\n      company_name: j.company_name || domain,\n      decision_maker: j.is_exec_budget_holder ? `Executive Hire (${j.job_title})` : 'Security / RevOps Lead',\n      signal_detail: `${j.primary_intent || 'HIRING'} - ${j.job_title || ''} (${(j.detected_tools || []).slice(0, 5).join(', ')})`,\n      salary_summary: j.salary_summary || 'Not Disclosed',\n      signal_url: j.job_url || '',\n      intent_score: Number(j.intent_score || 50)\n    }\n  });\n}\nreturn out;"
      }
    },
    {
      "id": "ent-node-05-norm-formd",
      "name": "Normalize Form D Signals & Derive Domains",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        560
      ],
      "parameters": {
        "jsCode": "const suffixRe = /\\b(llc|inc|incorporated|corp|corporation|co|company|ltd|lp|llp|holdings|group|technologies|technology|bio|therapeutics|labs|solutions|systems|partners|ventures)\\b/gi;\nconst seen = new Set();\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  const raw = String(j.entity_name || '').trim();\n  if (!raw) continue;\n  const clean = raw.toLowerCase().replace(/[^a-z0-9 ]/g, ' ').replace(/\\s+/g, ' ').trim();\n  const core = clean.replace(suffixRe, '').replace(/\\s+/g, '');\n  const compact = clean.replace(/\\s+/g, '');\n  const domain = (core.length >= 4 && core.length <= 26) ? `${core}.com` : ((compact.length >= 4 && compact.length <= 26) ? `${compact}.com` : '');\n  if (!domain || seen.has(domain)) continue;\n  seen.add(domain);\n  out.push({\n    json: {\n      domain,\n      signal_source: 'SEC_FORM_D_FUNDING',\n      company_name: raw,\n      decision_maker: `${j.executive_name || 'CEO'} (${j.executive_roles || 'Executive'})`,\n      signal_detail: `$${Number(j.total_amount_sold_usd || 0).toLocaleString()} Form D Filing (${j.industry_group || 'Operating Co'})`,\n      phone_formatted: j.phone_formatted || '',\n      signal_url: j.sec_xml_url || '',\n      intent_score: 85\n    }\n  });\n}\nreturn out;"
      }
    },
