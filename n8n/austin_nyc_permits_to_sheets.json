        "method": "POST",
        "url": "https://api.apify.com/v2/acts/pipeforge~us-socrata-b2b-signal-crossjoin-engine/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"mode\": \"permits_verified_phone\",\n  \"limit\": 25,\n  \"minPermitValuationUsd\": 75000\n}",
        "options": {
