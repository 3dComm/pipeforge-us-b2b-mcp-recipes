          "conditions": [
            {
              "id": "filter-phone-present",
              "leftValue": "={{ $json.contractor_phone }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            },
            {
              "id": "filter-val-or-nyc-tier",
              "leftValue": "={{ $json.valuation_usd === 'EST_MAJOR_NB_A1' ? 100000 : Number($json.valuation_usd) }}",
              "rightValue": 75000,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
